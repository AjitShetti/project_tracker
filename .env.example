# Table configuration
TABLE_NAME=side-project-tracker

# DynamoDB endpoint URL (set to http://localhost:8000 for local DynamoDB; leave empty when deploying to AWS)
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Shared secret for X-API-Key header authentication.
# Set this to empty (API_KEY=) to disable the check entirely for a local run -
# no header needed on any request. Never do that for a deployed stack; the
# ApiKey parameter in template.yaml enforces a 16-character minimum so
# CloudFormation refuses to ship an open API.
API_KEY=dev-secret-key

# AWS Region (ap-south-1 is Mumbai)
AWS_REGION=ap-south-1

# Execution environment
ENVIRONMENT=local

# Local AWS dummy credentials for boto3 when using DynamoDB Local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
